{
  "platform": "azure-devops",
  "name": "Bug Report",
  "title": "{title}",
  "description": "{description}",
  "type": "Bug",
  "fields": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "string",
      "required": true,
      "minLength": 10
    },
    "type": {
      "type": "string",
      "required": true,
      "enum": [
        "Bug",
        "Feature",
        "Task"
      ]
    }
  }
}
